[
 {
  "k": 276,
  "layer": 35,
  "neuron": 7008,
  "label": "Lowercase ' un' prefix token, as a standalone subword in mid-sentence words",
  "positive_pole": "The standalone subword token ' un' (lowercase, with a leading space) when it begins a word that the tokenizer splits as ' un' + stem. Examples: un|reported, un|cles, un|secured, un|-usable, un|asked, un|controlled, un|hide, un|wise, un|forgeable, un|traceable, un|movable, un|obtainable, un|plug, un|attended, un|professional. It fires whether ' un' is the negating prefix or just the first piece of a word like 'uncles' or 'unquote'. It is strongest in running mid-sentence prose. The activation sits entirely on the ' un' token. The following stem token is ~0. Similar word-initial split prefixes get weaker activation: ' er'(adicating/asing) ~3, ' se'(aring) ~3, ' ca'(utions) ~4, ' ir'(ritable) ~2. Fused prefixes like ' uns'(uitable), ' unt'(itled), ' ut', ' lib', ' so' give ~1.",
  "negative_pole": "Weak, max about -3. It comes from capitalized 'Un' at the start of a line, list item, title, or product name ('- Unlined', 'Unisex Watch', 'Unquestionable', 'Unabashedly', 'Unirse'). It also comes from lowercase 'un' directly after an opening quote mark with no space ('\"unremittingly', '\u201cunprecedented', '\u201cunbelievably'), and occasionally from the next fragment ('ab' after 'Un' \u2248 -2, '\u201cam|azing' \u2248 -1).",
